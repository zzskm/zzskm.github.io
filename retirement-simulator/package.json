{
  "name": "retirement-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/model/*.test.js tests/insights/*.test.js tests/state/*.test.js && node tests/static.test.js",
    "test:e2e": "playwright test",
    "serve:test": "node scripts/serve-preview.js",
    "profile": "node scripts/profile.js"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "vite": "6.1.6",
    "tailwindcss": "3.4.17",
    "postcss": "8.5.3",
    "autoprefixer": "10.4.21",
    "@playwright/test": "1.51.1"
  }
}
